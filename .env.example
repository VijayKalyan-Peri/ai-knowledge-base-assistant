# Copy this file to .env and fill in one provider configuration.
# Keep .env private. Never commit API keys.

# Hosted API example (OpenAI-compatible Chat Completions endpoint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=replace-with-a-model-available-to-your-account
LLM_API_KEY=replace-with-your-api-key

# Local Ollama example: replace the three values above with:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=replace-with-a-model-installed-in-Ollama
# LLM_API_KEY=ollama

LLM_TIMEOUT_SECONDS=60
